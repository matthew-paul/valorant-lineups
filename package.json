{
  "name": "valorant-lineups",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "emailjs-com": "^3.2.0",
    "prop-types": "^15.7.2",
    "react": "18.2.0",
    "react-dnd": "14.0.5",
    "react-dnd-html5-backend": "14.1.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.3.1",
    "react-map-interaction": "^2.0.0",
    "react-multi-select-component": "^4.2.5",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "react-select": "^5.3.1",
    "react-tag-input": "6.8.1",
    "react-toastify": "^8.2.0",
    "reactjs-popup": "^2.0.5",
    "reselect": "4.1.7",
    "warning": "4.0.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "prestart": "npm run css:build",
    "build": "cross-env GENERATE_SOURCEMAP=false react-scripts build",
    "prebuild": "npm run css:build",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "react-scripts test --watchAll=false --runInBand",
    "test:watch": "react-scripts test",
    "test:coverage": "react-scripts test --watchAll=false --runInBand --coverage",
    "css:build": "sass src/scss/main.scss src/css/main.min.css --style=compressed --source-map",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "@types/react": "18.0.28",
    "@types/react-dom": "18.0.11",
    "nwsapi": "2.2.2",
    "lodash": "^4.18.0",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "13.4.0",
    "@types/jest": "27.5.2",
    "@types/node": "18.15.5",
    "@types/react": "18.0.28",
    "@types/react-dom": "18.0.11",
    "@types/react-tag-input": "6.6.6",
    "@types/warning": "3.0.3",
    "cross-env": "^7.0.3",
    "sass": "1.77.8",
    "typescript": "4.9.5"
  }
}
